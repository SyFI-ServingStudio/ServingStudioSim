**/.git
**/.venv
**/__pycache__
**/*.pyc
.uv
target
logs
.launcher
.codex
.claude
profiling/profile.db
*.db-journal
*.parquet
*.pftrace
trace
alignment/load_generator
alignment/profiler/vllm
