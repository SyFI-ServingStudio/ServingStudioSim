  "formulas": {
    "decode_batch_mean_pct": "ratio(workload.metrics.decode_batch_size.{simulated,measured}.mean)",
    "e2e_mean_pct": "ratio(e2e.latency.e2e.{simulated,measured}_ms.mean)",
    "gpu_time_multiplier": "iteration.meta.recommended_gpu_time_multiplier",
    "iteration_cycle_mean_pct": "ratio(workload.metrics.iteration_cycle_ms.{simulated,measured}.mean)",
    "iterations_pct": "ratio(workload.meta.{simulated,measured}_iterations)",
    "kernel_abs_pct": "iteration.comparison.all.absolute_error_pct",
    "kernel_signed_pct": "iteration.comparison.all.signed_error_pct",
    "map_coverage_pct": "iteration.mapping.coverage.measured_duration_fraction * 100",
    "output_tps_pct": "ratio(e2e.throughput.simulated_completion_tps, e2e.throughput.measured_client_completion_tps)",
    "prefill_tokens_mean_pct": "ratio(workload.metrics.prefill_tokens.{simulated,measured}.mean)",
    "scheduled_kv_mean_pct": "ratio(workload.metrics.scheduled_kv_tokens.{simulated,measured}.mean)",
    "server_tpot_mean_pct": "ratio(e2e.latency.server_tpot.{simulated,measured}_ms.mean)",
