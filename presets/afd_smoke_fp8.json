{
 "deployment": "afd",
 "workload": {
  "trace_files": [
   "trace/smoke.csv"
  ],
  "trace_kind": "text_generation",
  "arrival_mode": "trace_timed",
  "session_dependency": "independent",
  "run_to_end": true
 },
 "io": {
  "log_dir": "logs/afd_smoke_fp8"
 },
 "pools": {
  "attn": {
   "groups": [
    {
     "gpu": "NVIDIA H200",
     "replicas": 8,
     "arch": {
      "type": "qwen3_attn_tp",
      "model_config": "model/config/qwen3_235b_fp8.json",
      "attn_tp_size": 4,
      "fp8": true
     },
     "worker": {
      "type": "disagg_attn",
      "attn_gpu_memory_gb": 144.0
     }
    }
   ]
  },
  "ffn": {
   "groups": [
    {
     "gpu": "NVIDIA H200",
     "replicas": 2,
     "arch": {
      "type": "qwen3_ffn_moe",
      "model_config": "model/config/qwen3_235b_fp8.json",
      "attn_tp_size": 4,
      "ep_size": 8,
      "nvl_num_gpu": 8,
      "fp8": true
     },
     "worker": {
      "type": "disagg_ffn"
     }
    }
   ]
  }
 }
}
