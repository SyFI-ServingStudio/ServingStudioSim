{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibesim.local/schema/expert_popularity_v4.schema.json",
  "title": "Replay-scoped target or draft expert popularity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "model_role", "num_moe_layers", "num_logical_experts", "expert_parallel_size", "experts_per_rank", "experts_per_token", "count_semantics", "aggregation", "expert_partitioning", "counts_by_layer", "probabilities_by_layer", "counts_all_layers", "probabilities_all_layers"],
  "properties": {
    "schema_version": {"const": 4},
    "model": {"type": "string", "minLength": 1},
    "model_role": {"enum": ["target", "draft"]},
    "num_moe_layers": {"type": "integer", "minimum": 1},
    "num_logical_experts": {"type": "integer", "minimum": 1},
    "expert_parallel_size": {"type": "integer", "minimum": 1},
    "experts_per_rank": {"type": "integer", "minimum": 1},
    "experts_per_token": {"type": "integer", "minimum": 1},
    "count_semantics": {"const": "logical_routed_token_assignments"},
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "observed_eplb_step_min", "observed_eplb_step_max", "record_count", "raw_record_count", "discarded_oversized_record_count", "discarded_oversized_eplb_steps", "discarded_outside_replay_window_record_count", "max_tokens_per_step", "max_forwards_per_step", "replay_start_monotonic_ns", "replay_end_monotonic_ns", "observed_monotonic_ns_min", "observed_monotonic_ns_max"],
      "properties": {
        "scope": {"const": "replay_window_within_role_specific_token_ceiling"},
        "observed_eplb_step_min": {"type": "integer", "minimum": 0},
        "observed_eplb_step_max": {"type": "integer", "minimum": 0},
        "record_count": {"type": "integer", "minimum": 1},
        "raw_record_count": {"type": "integer", "minimum": 1},
        "discarded_oversized_record_count": {"type": "integer", "minimum": 0},
        "discarded_oversized_eplb_steps": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "discarded_outside_replay_window_record_count": {"type": "integer", "minimum": 0},
        "max_tokens_per_step": {"type": "integer", "minimum": 1},
        "max_forwards_per_step": {"type": "integer", "minimum": 1},
        "replay_start_monotonic_ns": {"type": "integer", "minimum": 1},
        "replay_end_monotonic_ns": {"type": "integer", "minimum": 1},
        "observed_monotonic_ns_min": {"type": "integer", "minimum": 1},
        "observed_monotonic_ns_max": {"type": "integer", "minimum": 1}
      }
    },
    "expert_partitioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "layout"],
      "properties": {
        "kind": {"const": "contiguous_logical_expert_ids"},
        "layout": {"const": "rank_major"}
      }
    },
    "counts_by_layer": {"$ref": "#/$defs/countMatrix"},
    "probabilities_by_layer": {"$ref": "#/$defs/probabilityMatrix"},
    "counts_all_layers": {"$ref": "#/$defs/countVector"},
    "probabilities_all_layers": {"$ref": "#/$defs/probabilityVector"}
  },
  "$defs": {
    "countVector": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "probabilityVector": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "countMatrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/countVector"}},
    "probabilityMatrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/probabilityVector"}}
  }
}
