{
 "version": 1,
 "disable_existing_loggers": false,
 "formatters": {
  "vllm": {
   "class": "alignment.neuron.vllm_handoff_log.VllmLineFormatter",
   "datefmt": "%m-%d %H:%M:%S",
   "format": "%(levelname)s %(asctime)s [%(fileinfo)s:%(lineno)d] %(message)s"
  }
 },
 "filters": {
  "handoff_stamp": {
   "()": "alignment.neuron.vllm_handoff_log.HandoffStampFilter"
  }
 },
 "handlers": {
  "vllm": {
   "class": "logging.StreamHandler",
   "formatter": "vllm",
   "level": "INFO",
   "stream": "ext://sys.stdout"
  }
 },
 "loggers": {
  "vllm": {
   "handlers": ["vllm"],
   "level": "INFO",
   "propagate": false
  },
  "vllm.v1.engine.async_llm": {
   "filters": ["handoff_stamp"]
  },
  "vllm.entrypoints.logger": {
   "level": "WARNING"
  },
  "vllm.entrypoints.serve.utils.request_logger": {
   "level": "WARNING"
  }
 }
}
