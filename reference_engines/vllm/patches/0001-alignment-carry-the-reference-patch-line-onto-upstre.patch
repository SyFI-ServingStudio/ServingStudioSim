+
+def test_dp_busy_loop_dummy_batch_records_each_forward_once(monkeypatch):
+    """DPEngineCoreProc's busy loop calls self.execute_dummy_batch(), which
+    resolves to EngineCoreProc's override, not EngineCore's. Each dummy forward
+    on that path takes one forward ordinal and writes one schema-5 record."""
+    calls = []
+    monkeypatch.setattr(
+        "vllm.v1.engine.core.logger.info", lambda *args: calls.append(args)
+    )
+    engine = make_dp_dummy_engine()
+    assert DPEngineCoreProc.execute_dummy_batch is EngineCoreProc.execute_dummy_batch
+
+    DPEngineCoreProc.execute_dummy_batch(engine)
+    DPEngineCoreProc.execute_dummy_batch(engine)
+
+    assert engine.executed == ["dummy", "dummy"]
+    records = alignment_records(calls)
+    assert [record["forward_ordinal"] for record in records] == [0, 1]
+    assert all(record["is_dummy"] for record in records)
+    assert all(record["iteration_index"] is None for record in records)
+    assert {record["dp_rank"] for record in records} == {1}
+    assert {record["max_forwards_in_flight"] for record in records} == {2}
+
+
+def test_dp_busy_loop_dummy_batch_records_and_publishes_gpu_timings(monkeypatch):
+    """The alignment record does not displace the GPU timings the override
+    publishes."""
+    calls = []
