+def make_dp_dummy_engine(records=None, enabled: bool = True) -> SimpleNamespace:
+    """A DP rank as DPEngineCoreProc's busy loop sees it when it runs a dummy."""
+    engine = SimpleNamespace(
+        vllm_config=SimpleNamespace(
+            observability_config=SimpleNamespace(
+                enable_logging_iteration_details=enabled,
+            ),
+            parallel_config=SimpleNamespace(data_parallel_rank=1),
+        ),
+        batch_queue_size=2,
+        executed=[],
+        scheduler=SimpleNamespace(make_stats=SchedulerStats),
+        output_queue=queue.Queue(),
+    )
+
+    def execute_dummy_batch():
+        engine.executed.append("dummy")
+        return records
+
+    engine.model_executor = SimpleNamespace(execute_dummy_batch=execute_dummy_batch)
+    engine.log_dummy_forward = lambda: EngineCore.log_dummy_forward(engine)
