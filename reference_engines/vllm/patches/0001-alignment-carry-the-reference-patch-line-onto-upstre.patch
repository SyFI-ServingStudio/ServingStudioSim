+    assert len(alignment_records(calls)) == 1
+    client_index, outputs = engine.output_queue.get_nowait()
+    assert client_index == 0
+    assert outputs.scheduler_stats.iteration_records == [timing]
+
+
+def test_dp_busy_loop_dummy_batch_is_not_recorded_when_logging_is_off(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        "vllm.v1.engine.core.logger.info", lambda *args: calls.append(args)
