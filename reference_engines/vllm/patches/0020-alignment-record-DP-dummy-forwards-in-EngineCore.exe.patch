         ran no real one, so that its EP/DP collectives pair with its peers'.
         Recording it (no scheduled work, `is_dummy`) gives each rank one record
         per forward, so the k-th forward of every rank can be joined by
-        `forward_ordinal` instead of by wall clock.
+        `forward_ordinal` instead of by wall clock. `execute_dummy_batch` is its
+        only caller, so every dummy path records exactly once.
         """
         if not self.vllm_config.observability_config.enable_logging_iteration_details:
             yield
@@ -1341,7 +1342,11 @@ class EngineCore:
         )
 
     def execute_dummy_batch(self):
-        self.model_executor.execute_dummy_batch()
+        # Every DP dummy forward enters here: DPEngineCoreProc's busy loop, the
+        # offline LLMEngine.step() (through the in-process or utility client)
+        # and any other caller, so each takes one forward ordinal and records.
+        with self.log_dummy_forward():
+            self.model_executor.execute_dummy_batch()
 
     def compute_weight_checksums(self) -> list[dict[str, str]]:
         return self.collective_rpc("compute_weight_checksums")
@@ -2909,10 +2914,7 @@ class DPEngineCoreProc(EngineCoreProc):
                 # Execute a dummy pass when no ready requests ran, unless the
                 # engine is sleeping.
                 elif not self.model_executor.is_sleeping:
-                    with (
-                        self.capture_iteration_details(None) as iteration_details,
-                        self.log_dummy_forward(),
-                    ):
+                    with self.capture_iteration_details(None) as iteration_details:
                         self.execute_dummy_batch()
                     if iteration_details is not None and not self.has_coordinator:
                         stats = self._make_iteration_details_stats(iteration_details)
