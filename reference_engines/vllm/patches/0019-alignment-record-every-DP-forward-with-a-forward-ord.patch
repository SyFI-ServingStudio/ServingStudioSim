diff --git a/vllm/v1/engine/core.py b/vllm/v1/engine/core.py
index 0b6ef79e7183c4ddff33082dec4f7420ce401038..8f1e846ac3a2651c3ded2221fd4e88c490624b6e 100644
--- a/vllm/v1/engine/core.py
+++ b/vllm/v1/engine/core.py
@@ -128,6 +128,13 @@ HANDSHAKE_TIMEOUT_MINS = 5
 _R = TypeVar("_R")  # Return type for collective_rpc
 
 
+def _take_forward_ordinal(engine: Any) -> int:
+    """Next per-rank model-forward ordinal (real and DP dummy forwards alike)."""
+    ordinal = getattr(engine, "_next_alignment_forward_ordinal", 0)
+    engine._next_alignment_forward_ordinal = ordinal + 1
+    return ordinal
+
+
 class EngineCore:
     """Inner loop of vLLM's Engine."""
 
@@ -686,9 +693,13 @@ class EngineCore:
         )
         if scheduler_output is not None:
             alignment_record = {
-                "schema_version": 4,
+                "schema_version": 5,
                 "input_adapter": "vllm_text",
                 "iteration_index": iteration_index,
+                "forward_ordinal": scheduler_output.alignment_forward_ordinal,
+                "is_dummy": False,
+                "dp_rank": self.vllm_config.parallel_config.data_parallel_rank,
+                "max_forwards_in_flight": getattr(self, "batch_queue_size", 1),
                 "observed_start_monotonic_ns": observed_start_monotonic_ns,
                 "observed_end_monotonic_ns": observed_end_monotonic_ns,
                 "observed_elapsed_ms": observed_elapsed_ms,
@@ -712,10 +723,61 @@ class EngineCore:
     def assign_alignment_iteration_index(
         self, scheduler_output: SchedulerOutput
     ) -> None:
-        """Attach one dispatch-order index shared by EngineCore logs and worker NVTX."""
+        """Attach one dispatch-order index shared by EngineCore logs and worker NVTX.
+
+        A step that will run a forward also takes the next forward ordinal; a
+        0-token step runs none (the DP loop then runs a dummy forward, which
+        takes the ordinal instead).
+        """
         next_index = getattr(self, "_next_alignment_iteration_index", 0)
         scheduler_output.alignment_iteration_index = next_index
         self._next_alignment_iteration_index = next_index + 1
+        if scheduler_output.total_num_scheduled_tokens > 0:
+            scheduler_output.alignment_forward_ordinal = _take_forward_ordinal(self)
+
+    @contextmanager
+    def log_dummy_forward(self) -> Generator[None, None, None]:
+        """Record one DP dummy forward as a schema-5 alignment iteration record.
+
+        An idle DP rank runs a dummy forward on every busy-loop pass in which it
+        ran no real one, so that its EP/DP collectives pair with its peers'.
+        Recording it (no scheduled work, `is_dummy`) gives each rank one record
+        per forward, so the k-th forward of every rank can be joined by
+        `forward_ordinal` instead of by wall clock.
+        """
+        if not self.vllm_config.observability_config.enable_logging_iteration_details:
+            yield
+            return
+        forward_ordinal = _take_forward_ordinal(self)
+        observed_start_monotonic_ns = time.monotonic_ns()
+        yield
+        observed_end_monotonic_ns = time.monotonic_ns()
+        alignment_record = {
+            "schema_version": 5,
+            "input_adapter": "vllm_text",
+            "iteration_index": None,
+            "forward_ordinal": forward_ordinal,
+            "is_dummy": True,
+            "dp_rank": self.vllm_config.parallel_config.data_parallel_rank,
+            "max_forwards_in_flight": getattr(self, "batch_queue_size", 1),
+            "observed_start_monotonic_ns": observed_start_monotonic_ns,
+            "observed_end_monotonic_ns": observed_end_monotonic_ns,
+            "observed_elapsed_ms": (
+                observed_end_monotonic_ns - observed_start_monotonic_ns
+            )
+            / 1e6,
+            "prefill_tokens": 0,
+            "decode_requests": 0,
+            "decode_tokens_scheduled": 0,
+            "prefill_chunk_pairs": [],
+            "decode_kv_lens": [],
+            "decode_query_lens": [],
+            "decode_request_progress": [],
+        }
+        logger.info(
+            "VibeSimAlignmentIteration %s",
+            json.dumps(alignment_record, separators=(",", ":")),
+        )
 
     @contextmanager
     def capture_iteration_details(
@@ -2847,7 +2909,10 @@ class DPEngineCoreProc(EngineCoreProc):
                 # Execute a dummy pass when no ready requests ran, unless the
                 # engine is sleeping.
                 elif not self.model_executor.is_sleeping:
-                    with self.capture_iteration_details(None) as iteration_details:
+                    with (
+                        self.capture_iteration_details(None) as iteration_details,
+                        self.log_dummy_forward(),
+                    ):
                         self.execute_dummy_batch()
                     if iteration_details is not None and not self.has_coordinator:
                         stats = self._make_iteration_details_stats(iteration_details)
