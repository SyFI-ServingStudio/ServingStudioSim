+
+
+def _alignment_records(records):
+    return [
+        json.loads(args[1])
+        for args in records
+        if args[0] == "VibeSimAlignmentIteration %s"
+    ]
+
+
+def test_every_forward_takes_one_ordinal_dummies_included(monkeypatch):
+    """Real steps and DP dummy forwards share one per-rank forward count; a
+    0-token step runs no forward and takes none."""
+    records = []
+    monkeypatch.setattr(
+        "vllm.v1.engine.core.logger.info", lambda *args: records.append(args)
+    )
+    engine = make_fake_engine()
+    real = SimpleNamespace(total_num_scheduled_tokens=4)
+    EngineCore.assign_alignment_iteration_index(engine, real)
+    assert real.alignment_forward_ordinal == 0
+
+    empty = SimpleNamespace(total_num_scheduled_tokens=0, alignment_forward_ordinal=None)
+    EngineCore.assign_alignment_iteration_index(engine, empty)
+    assert empty.alignment_forward_ordinal is None
+    with EngineCore.log_dummy_forward(engine):
+        pass
+
+    later = SimpleNamespace(total_num_scheduled_tokens=1)
+    EngineCore.assign_alignment_iteration_index(engine, later)
+    assert later.alignment_iteration_index == 2
+    assert later.alignment_forward_ordinal == 2
+
+    (dummy,) = _alignment_records(records)
+    assert dummy["schema_version"] == 5
+    assert dummy["is_dummy"] is True
+    assert dummy["forward_ordinal"] == 1
+    assert dummy["iteration_index"] is None
+    assert dummy["dp_rank"] == 2
+    assert dummy["max_forwards_in_flight"] == 2
+    assert dummy["prefill_tokens"] == dummy["decode_requests"] == 0
+    assert dummy["prefill_chunk_pairs"] == dummy["decode_kv_lens"] == []
+    assert dummy["decode_query_lens"] == dummy["decode_request_progress"] == []
+    assert dummy["observed_end_monotonic_ns"] >= dummy["observed_start_monotonic_ns"]
+
+
+def test_dummy_forward_is_not_recorded_when_iteration_logging_is_off(monkeypatch):
+    records = []
+    monkeypatch.setattr(
+        "vllm.v1.engine.core.logger.info", lambda *args: records.append(args)
+    )
+    engine = make_fake_engine()
+    engine.vllm_config.observability_config.enable_logging_iteration_details = False
+    with EngineCore.log_dummy_forward(engine):
+        pass
+    assert records == []
