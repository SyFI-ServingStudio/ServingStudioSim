# Rust
/target/
**/*.rs.bk
Cargo.lock

# Python
__pycache__/
*.py[cod]
.venv/
.uv/

# Data
*.parquet
*.pftrace
profile.db-journal
logs/
# Large workload trace: provisioned per-worktree, not tracked (see create-worktree)
trace/aime_long.csv
# TraceLab session traces, ~23 MB each. Deterministic output, so regenerate them
# rather than carry them in history; the committed .manifest.json beside each one
# records the source hash and the totals a run needs to check itself against.
trace/tracelab_*.csv

# Editor / OS
.vscode/
.idea/
.DS_Store

# Agent runtime state (per-machine; .claude/ and .codex/ skills symlinks
# are tracked, local settings files are not)
.claude/settings.local.json
.codex/*.local.*

# Generated docs / sample output — regenerable, not source of truth
.code-lessons/
model/work/examples/

/tmp/
