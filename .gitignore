# Rust
/target/
**/*.rs.bk
Cargo.lock

# Python
__pycache__/
*.py[cod]
.venv/
.uv/

# Data
*.parquet
*.pftrace
profile.db-journal
logs/
# Large workload traces: provisioned per-worktree, not tracked (see create-worktree).
# The full-dataset TraceLab traces are ~23 MB each; their manifests ARE committed
# beside them, so the repo still records what policy produced each file and how
# much prefix that policy folded into fresh input.
trace/aime_long.csv
trace/tracelab_reported.csv
trace/tracelab_preserving.csv

# Editor / OS
.vscode/
.idea/
.DS_Store

# Agent runtime state (per-machine; .claude/ and .codex/ skills symlinks
# are tracked, local settings files are not)
.claude/settings.local.json
.codex/*.local.*

# Generated docs / sample output — regenerable, not source of truth
.code-lessons/
model/work/examples/

/tmp/
