# Rust
/target/
**/*.rs.bk
Cargo.lock

# Python
__pycache__/
*.py[cod]
.venv/
.uv/

# Data
*.parquet
*.pftrace
profile.db-journal
logs/
# Large workload trace: provisioned per-worktree, not tracked (see create-worktree)
trace/aime_long.csv
# Session traces derived from the TraceLab corpus: ~23 MB per CSV and ~114 MB
# per plan sidecar, all deterministic output of one `tracegen` run, so
# regenerate them rather than carry them in history. The .manifest.json beside
# each one stays tracked: it records the source hash, the policy, and the totals
# a run checks itself against.
trace/tracelab_*
!trace/tracelab_*.manifest.json

# Editor / OS
.vscode/
.idea/
.DS_Store

# Agent runtime state (per-machine; .claude/ and .codex/ skills symlinks
# are tracked, local settings files are not)
.claude/settings.local.json
.codex/*.local.*

# Alignment host profiles are local. A real one is nothing but absolute paths --
# an HF cache, a 1 GB corpus, an nsys install -- so it names whoever's directory
# it happens to sit in, and no tracked preset in this repo carries a host
# absolute path. Only the template is tracked; what is reproducible about a
# machine that produced accepted numbers goes in that pack's `recorded_on`.
presets/alignment/hosts/*.yaml
!presets/alignment/hosts/example.yaml

# Task-local agent notes are working state, not repository documentation.
/progress.md
/update_plan_for_skils.md

# Generated docs / sample output — regenerable, not source of truth
.code-lessons/
model/work/examples/

/tmp/
.cache/
